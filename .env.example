# Copia este fichero a .env y ajusta lo que haga falta.
#   cp .env.example .env
#
# Todo lo que la aplicacion lee del entorno esta aqui. Lo que va comentado tiene un valor por
# defecto en application*.yml que sirve tal cual en local.

# --- La propia aplicacion ----------------------------------------------------------------------
# dev | test | prod. En dev el navegador se abre solo y el secreto local ya viene puesto.
SPRING_PROFILES_ACTIVE=dev
# Puerto en local (perfil dev). Dentro de compose la aplicacion escucha en el 8080.
SERVER_PORT=8085
# Puerto publicado en el host por compose. Tiene que ser el del redirect URI del cliente (8085).
APP_PORT=8085

# --- Keycloak ----------------------------------------------------------------------------------
KEYCLOAK_ISSUER_URI=http://auth.mto.local:8082/realms/mto
# Cliente confidencial de esta aplicacion (keycloak/mto-backoffice-partial-import.json).
KEYCLOAK_CLIENT_ID=mto-backoffice
# El secreto que fija keycloak/mto-backoffice-dev.json en el realm local. En un entorno desplegado,
# Clients -> mto-backoffice -> Credentials.
KEYCLOAK_CLIENT_SECRET=mto-backoffice-secret
# Cliente cuyos roles del access token son los permisos de las pantallas.
#KEYCLOAK_ROLES_CLIENT_IDS=mto-configuration-api,mto-users-api,mto-stock-api

# --- Gateway -----------------------------------------------------------------------------------
# Toda llamada sale por el gateway. Desde el IDE, el 8090 del host; desde compose, por el host.
MTO_GATEWAY_URL=http://localhost:8090
#MTO_GATEWAY_CONNECT_TIMEOUT=2s
#MTO_GATEWAY_READ_TIMEOUT=15s

# --- Logging -----------------------------------------------------------------------------------
#LOGGING_LEVEL_ROOT=INFO
#LOGGING_LEVEL_APP=DEBUG
